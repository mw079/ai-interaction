# Copy this file to .env and fill in your own values. .env is ignored by Git.

# Server-side OpenAI key. Without it the app runs in demo mode with built-in examples.
OPENAI_API_KEY=

# Requests per visitor per UTC day, and for the whole app per day (a cap on spending).
DAILY_LIMIT=200
DAILY_TOTAL_LIMIT=2000

# Port for `npm run dev`.
PORT=4317
